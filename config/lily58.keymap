#define MAC 0
#define WIN 1
#define L1 2
#define L2 3
#define L3 4

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <400>;
    hold-trigger-key-positions = <>;
    flavor = "tap-preferred";
};

/ {
    macros {
        remove_line: remove_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp END &kp LG(BACKSPACE)>;
            label = "REMOVE_LINE";
        };

        WIN: WIN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&to 1 &tog 2 &tog 3 &tog 4 &tog 1>,
                <&macro_pause_for_release>,
                <&bt BT_SEL 0>,
                <&macro_wait_time 1500>,
                <&macro_release>;

            label = "WIN";
        };

        MAC: MAC {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&to 0 &tog 2 &tog 3 &tog 4 &tog 0>,
                <&macro_pause_for_release>,
                <&bt BT_SEL 1>,
                <&macro_wait_time 1500>,
                <&macro_release>;

            label = "MAC";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        MACOS {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "mbase";
            bindings = <
&kp ESC     &mt TILDE NUMBER_1  &kp N2      &kp N3            &kp N4      &kp N5                          &kp N6  &kp N7               &kp N8             &kp N9      &kp N0          &kp MINUS
&kp TAB     &kp Q               &kp W       &kp E             &kp R       &kp T                           &kp Y   &kp U                &kp I              &kp O       &kp P           &mt EQUAL LEFT_BRACKET
&kp LSHIFT  &mt LCTRL A         &mt LALT S  &mt LEFT_SHIFT D  &mt LGUI F  &kp G                           &kp H   &mt RGUI J           &mt RIGHT_SHIFT K  &mt RALT L  &mt RCTRL SEMI  &kp SQT
&kp LCTRL   &kp Z               &kp X       &kp C             &kp V       &kp B   &kp LG(C)    &kp LG(V)  &kp N   &mt RIGHT_BRACKET M  &kp COMMA          &kp DOT     &kp FSLH        &kp RSHFT
                                            &kp LALT          &kp LGUI    &mo 3   &kp SPACE    &kp RET    &mo 2   &kp BSPC             &kp LC(LA(SPACE))
            >;
        };

        WINDOWS {
            display-name = "mwin";
            bindings = <
&kp ESC       &mt TILDE NUMBER_1  &kp N2  &kp N3    &kp N4     &kp N5                          &kp N6  &kp N7    &kp N8              &kp N9   &kp N0    &kp MINUS
&kp TAB       &kp Q               &kp W   &kp E     &kp R      &kp T                           &kp Y   &kp U     &kp I               &kp O    &kp P     &kp EQUAL
&kp LSHIFT    &kp A               &kp S   &kp D     &kp F      &kp G                           &kp H   &kp J     &kp K               &kp L    &kp SEMI  &kp SQT
&kp LEFT_ALT  &kp Z               &kp X   &kp C     &kp V      &kp B   &kp LC(C)    &kp LC(V)  &kp N   &kp M     &kp COMMA           &kp DOT  &kp FSLH  &kp RSHFT
                                          &kp RGUI  &kp LCTRL  &mo 3   &kp SPACE    &kp RET    &mo 2   &kp BSPC  &kp LC(LEFT_SHIFT)
            >;
        };

        L1 {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "L1";
            bindings = <
&bt BT_CLR      &WIN               &MAC               &bt BT_SEL 2           &bt BT_SEL 3       &bt BT_SEL 4                               &kp C_RW           &kp C_PLAY_PAUSE  &kp C_FAST_FORWARD  &kp K_MUTE       &kp C_VOL_DN    &kp C_VOLUME_UP
&kp TAB         &kp LG(LS(SPACE))  &kp LA(LC(LG(W)))  &kp LA(LC(LG(LS(E))))  &kp LA(LG(LC(R)))  &kp LA(LG(LC(T)))                          &kt LA(BACKSPACE)  &kp LA(LEFT)      &kp UP_ARROW        &kp LA(RIGHT)    &kp LA(DELETE)  &kp F12
&kp LEFT_SHIFT  &kp LA(LC(SPACE))  &kp LC(LG(LA(S)))  &kp LA(LC(LG(SPACE)))  &kp LA(LC(LG(F)))  &kp LA(LC(LG(G)))                          &kp HOME           &kp LEFT          &kp DOWN            &kp RIGHT_ARROW  &kp END         &kp TILDE
&kp LCTRL       &kp LA(LG(LC(Z)))  &kp LA(LC(LG(X)))  &kp LA(LC(LG(C)))      &kp LA(LC(LG(V)))  &kp LA(LC(LG(B)))  &tog 0       &tog 1     &kp PG_UP          &kp PAGE_DOWN     &msc SCRL_UP        &msc SCRL_DOWN   &msc SCRL_UP    &kp PIPE
                                                      &kp LEFT_ALT           &kp LCMD           &none              &kp SPACE    &kp ENTER  &mo 4              &kp BACKSPACE     &remove_line
            >;
        };

        L2 {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "L2";
            bindings = <
&kp C_BRI_DEC  &kp C_BRIGHTNESS_INC  &kp C_AL_SELECT_TASK  &kp C_AC_SEARCH  &kp C_MEDIA_VCR  &kp C_SLEEP                               &kp C_RW       &kp C_PLAY_PAUSE  &kp C_FAST_FORWARD  &kp K_MUTE       &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
&kp GRAVE      &kp N1                &kp N2                &kp N3           &kp N4           &kp N5                                    &kp LA(PG_UP)  &msc SCRL_LEFT    &mmv MOVE_UP        &msc SCRL_RIGHT  &kt LA(DELETE)     &trans
&kp F1         &kp F2                &kp F3                &kp F4           &kp F5           &kp F6                                    &kp PAGE_DOWN  &mmv MOVE_LEFT    &mmv MOVE_DOWN      &mmv MOVE_RIGHT  &msc SCRL_DOWN     &trans
&kp F7         &kp F8                &kp F9                &kp F10          &kp F11          &kp F12      &kp LEFT_SHIFT    &kp ENTER  &kp HOME       &kp END           &kp EQUAL           &kp LBKT         &msc SCRL_UP       &kp BSLH
                                                           &kp LEFT_ALT     &kp LEFT_WIN     &none        &kp SPACE         &mkp LCLK  &mkp RCLK      &mkp MB4          &mkp MB5
            >;
        };

        L3 {
            display-name = "L3";
            bindings = <
&kp ESCAPE      &kp SQT            &trans           &trans                         &trans                 &trans                                            &trans            &kp CARET      &kp SLASH                   &kp ASTERISK  &kp MINUS  &trans
&kp GRAVE       &kp DOUBLE_QUOTES  &kp AMPERSAND    &mt LEFT_PARENTHESIS ASTERISK  &kp RIGHT_PARENTHESIS  &kp N5                                            &kp LEFT_BRACKET  &kp N7         &kp N8                      &kp N9        &kp PLUS   &kp BACKSLASH
&kp LEFT_SHIFT  &kp QUESTION       &kp DOLLAR       &kp PERCENT                    &kp CARET              &kp F6                                            &trans            &kp NUMBER_4   &kp N5                      &kp NUMBER_6  &kp EQUAL  &trans
&kp LCTRL       &kp SEMICOLON      &kp EXCLAMATION  &kp AT_SIGN                    &kp HASH               &kp F12  &trans       &mt GREATER_THAN LESS_THAN  &kp LEFT_BRACKET  &kp NUMBER_1   &kp NUMBER_2                &kp NUMBER_3  &kp RBKT   &kp BSLH
                                                    &kp LALT                       &kp LEFT_GUI           &none    &kp SPACE    &kp ENTER                   &trans            &kp BACKSPACE  &mt RIGHT_BRACE LEFT_BRACE
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
