#define MAC 0
#define WIN 1
#define L1 2
#define L2 3
#define L3 4

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <400>;
    hold-trigger-key-positions = <>;
    flavor = "tap-preferred";
};

&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <200>;
    trigger-period-ms = <8>;
};

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <140>;
    trigger-period-ms = <8>;
};

/ {
    macros {
        remove_line: remove_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp END &kp LG(BACKSPACE)>;
            label = "REMOVE_LINE";
        };
    };

    behaviors {
        tap_dance_copy_cut_mac: tap_dance_copy_cut_mac {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_COPY_CUT_MAC";
            #binding-cells = <0>;
            bindings = <&kp LG(C)>, <&kp LG(X)>;
        };

        tap_dance_copy_cut_win: tap_dance_copy_cut_win {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_COPY_CUT_WIN";
            #binding-cells = <0>;
            bindings = <&kp LC(C)>, <&kp LC(X)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        MACOS {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "mbase";
            bindings = <
&mt ESC TILDE   &kp NUMBER_1  &kp N2      &kp N3            &kp N4      &kp N5                                        &kp N6  &kp N7               &kp N8             &kp N9      &kp N0          &kp MINUS
&kp LEFT_SHIFT  &kp Q         &kp W       &kp E             &kp R       &kp T                                         &kp Y   &kp U                &kp I              &kp O       &kp P           &mt EQUAL LEFT_BRACKET
&kp TAB         &mt LCTRL A   &mt LALT S  &mt LEFT_SHIFT D  &mt LGUI F  &kp G                                         &kp H   &mt RGUI J           &mt RIGHT_SHIFT K  &mt RALT L  &mt RCTRL SEMI  &mt RIGHT_BRACKET SQT
&kp LCTRL       &kp Z         &kp X       &kp C             &kp V       &kp B   &tap_dance_copy_cut_mac    &kp LG(V)  &kp N   &mt RIGHT_BRACKET M  &kp COMMA          &kp DOT     &mt PIPE SLASH  &kp LG(TAB)
                                          &kp LALT          &kp LGUI    &mo 3   &kp SPACE                  &kp RET    &mo 2   &kp BSPC             &kp LC(LA(SPACE))
            >;
        };

        WINDOWS {
            display-name = "mwin";
            bindings = <
&mt ESC TILDE   &kp NUMBER_1  &kp N2  &kp N3    &kp N4     &kp N5                                        &kp N6  &kp N7    &kp N8              &kp N9   &kp N0  &kp MINUS
&kp LEFT_SHIFT  &kp Q         &kp W   &kp E     &kp R      &kp T                                         &kp Y   &kp U     &kp I               &kp O    &kp P   &trans
&kp TAB         &trans        &trans  &trans    &trans     &kp G                                         &kp H   &trans    &trans              &trans   &trans  &trans
&kp LEFT_ALT    &kp Z         &kp X   &kp C     &kp V      &kp B   &tap_dance_copy_cut_win    &kp LC(V)  &kp N   &trans    &kp COMMA           &kp DOT  &trans  &kp LC(TAB)
                                      &kp RGUI  &kp LCTRL  &mo 3   &kp SPACE                  &kp RET    &mo 2   &kp BSPC  &kp LC(LEFT_SHIFT)
            >;
        };

        L1 {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "L1";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0       &bt BT_SEL 1       &bt BT_SEL 2           &bt BT_SEL 3       &bt BT_SEL 4                               &kp C_RW           &kp C_PLAY_PAUSE  &kp C_FAST_FORWARD  &kp K_MUTE         &kp C_VOL_DN    &kp C_VOLUME_UP
&trans      &kp LG(LS(SPACE))  &kp LA(LC(LG(W)))  &kp LA(LC(LG(LS(E))))  &kp LA(LG(LC(R)))  &kp LA(LG(LC(T)))                          &kp LA(BACKSPACE)  &kp LA(LS(LEFT))  &kp UP_ARROW        &kp LA(LS(RIGHT))  &kp LA(DELETE)  &kp F12
&trans      &kp LA(LC(SPACE))  &kp LC(LG(LA(S)))  &kp LA(LC(LG(SPACE)))  &kp LA(LC(LG(F)))  &kp LA(LC(LG(G)))                          &kp HOME           &kp LEFT          &kp DOWN            &kp RIGHT_ARROW    &kp END         &kp TILDE
&kp LCTRL   &kp LA(LG(LC(Z)))  &kp LA(LC(LG(X)))  &kp LA(LC(LG(C)))      &kp LA(LC(LG(V)))  &kp LA(LC(LG(B)))  &tog 0       &tog 1     &kp PG_UP          &kp PAGE_DOWN     &msc SCRL_UP        &msc SCRL_DOWN     &msc SCRL_UP    &kp PIPE
                                                  &kp LEFT_ALT           &kp LCMD           &none              &kp SPACE    &kp ENTER  &mo 4              &kp BACKSPACE     &remove_line
            >;
        };

        L2 {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "L2";
            bindings = <
&kp C_BRI_DEC                      &kp C_BRIGHTNESS_INC  &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS  &kp C_AC_SEARCH  &kp C_MEDIA_VCR  &kp C_SLEEP                                      &kp C_RW       &kp C_PLAY_PAUSE  &kp C_FAST_FORWARD  &kp K_MUTE       &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
&kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &kp C_AC_EXIT         &kp C_AC_PROPS                          &kp C_AC_OPEN    &kp C_AL_WWW     &kp C_AC_BOOKMARKS                               &kp PG_UP      &msc SCRL_LEFT    &mmv MOVE_UP        &msc SCRL_RIGHT  &kp LA(DELETE)     &kp C_AL_WWW
&kp F1                             &kp F2                &kp F3                                  &kp F4           &kp F5           &kp F6                                           &kp PAGE_DOWN  &mmv MOVE_LEFT    &mmv MOVE_DOWN      &mmv MOVE_RIGHT  &msc SCRL_DOWN     &trans
&kp F7                             &kp F8                &kp F9                                  &kp F10          &kp F11          &kp F12             &kp LEFT_SHIFT    &kp ENTER  &kp HOME       &kp END           &kp EQUAL           &kp LBKT         &msc SCRL_UP       &kp BSLH
                                                                                                 &kp LEFT_ALT     &kp LEFT_WIN     &none               &kp SPACE         &mkp LCLK  &mkp RCLK      &mkp MB4          &mkp MB5
            >;
        };

        L3 {
            display-name = "L3";
            bindings = <
&kp ESCAPE      &kp SQT              &mt LA(NUMBER_9) LA(NUMBER_7)  &mt LA(SQT) LA(NUMBER_8)       &mt LA(C) LA(M)        &mt LA(DOT) LC(LG(SPACE))                                                                            &kp LEFT_PARENTHESIS  &kp CARET       &kp KP_DIVIDE   &kp KP_MULTIPLY        &kp KP_SUBTRACT  &kp RIGHT_PARENTHESIS
&trans          &kp DOUBLE_QUOTES    &mt AMPERSAND QUESTION         &mt LEFT_PARENTHESIS ASTERISK  &kp RIGHT_PARENTHESIS  &kp N5                                                                                               &kp LEFT_BRACE        &mt HOME KP_N7  &mt UP KP_N8    &mt PAGE_UP LS(KP_N9)  &kp KP_PLUS      &kp RIGHT_BRACE
&kp LEFT_SHIFT  &kp QUESTION         &mt DOLLAR LA(LS(NUMBER_2))    &kp PERCENT                    &kp CARET              &kp F6                                                                                               &kp LEFT_BRACKET      &mt LEFT KP_N4  &kp KP_N5       &mt RIGHT KP_N6        &kp KP_EQUAL     &kp RIGHT_BRACKET
&kp LCTRL       &mt COLON SEMICOLON  &kp EXCLAMATION                &kp AT_SIGN                    &kp HASH               &kp F12                    &mt C_AL_FILE_BROWSER C_MEDIA_COMPUTER    &mt C_AL_CALENDAR K_CALCULATOR  &kp LESS_THAN         &mt END KP_N1   &mt DOWN KP_N2  &mt PAGE_DOWN KP_N3    &kp RBKT         &kp GREATER_THAN
                                                                    &kp LALT                       &kp LEFT_GUI           &none                      &kp SPACE                                 &kp KP_ENTER                    &kp KP_N0             &kp BACKSPACE   &mt DEL KP_DOT
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
